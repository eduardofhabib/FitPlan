<% content_for :title, t('.title') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
  <div>
    <h1 class="mb-1"><i class="bi bi-trophy me-2 text-warning"></i><%= t('.title') %></h1>
    <p class="text-muted mb-0"><%= t('.description') %></p>
  </div>

  <div class="btn-group" role="group" aria-label="<%= t('.scopes_label') %>">
    <% Ranking::Leaderboard::SCOPES.each do |scope| %>
      <%= link_to t(".scopes.#{scope}"), rankings_path(rankings_filter_params(scope:)),
                  class: "btn btn-sm #{rankings_scope_active?(scope) ? 'btn-success' : 'btn-outline-success'}" %>
    <% end %>
  </div>
</div>

<div class="mb-4">
  <span class="d-block small fw-semibold text-muted mb-2"><%= t('.metrics_label') %></span>
  <div class="d-flex flex-wrap gap-2">
    <% Ranking::Metric.all.each do |metric| %>
      <%= link_to rankings_path(rankings_filter_params(metric: metric.key)),
                  class: "btn btn-sm #{rankings_metric_active?(metric) ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <i class="bi <%= metric.icon %> me-1"></i><%= ranking_metric_label(metric) %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @entries.any? %>
  <div class="d-grid gap-3">
    <%= render partial: 'entry', collection: @entries %>
  </div>
<% else %>
  <div class="text-center bg-body-tertiary rounded p-5">
    <i class="bi bi-people fs-1 text-muted"></i>
    <p class="text-muted mb-0 mt-2"><%= t('.empty') %></p>
  </div>
<% end %>
